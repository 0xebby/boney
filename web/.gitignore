# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# block-timestamp cache the relayer and the indexer share, rebuilt from the chain on demand
/.cache/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# One-off probe/send scripts. Underscore-prefixed throwaways that read PRIVATE_KEY from ../.env and
# poke Base Sepolia by hand; they are scratch, not tooling, and `git add -A` sweeps them up.
_*.mjs

# The verification dashboard's collected snapshot — a few hundred KB of chain and subgraph reads,
# rebuilt by `scripts/__dash-collect.mts`. The page it produces is committed; its input is not.
scripts/__dash-data.json
