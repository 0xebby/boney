{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.17.0",
  "scripts": {
    "dev": "next dev",
    "dev:up": "./scripts/dev-up.sh",
    "build": "NODE_OPTIONS=--max-old-space-size=8192 next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "node --max-old-space-size=8192 ./node_modules/typescript/bin/tsc --noEmit",
    "typecheck:scripts": "node --max-old-space-size=3072 ./node_modules/typescript/bin/tsc -p tsconfig.scripts.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "abis": "tsx scripts/extract-abis.ts",
    "followers:health": "tsx scripts/follower-health.ts",
    "ethos:stub": "tsx scripts/ethos-stub.ts",
    "ethos:stub:dev": "tsx scripts/ethos-stub-dev.ts",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "deployments": "tsx scripts/generate-deployments.ts",
    "seed": "tsx scripts/seed-local.ts",
    "index": "tsx scripts/indexer.ts",
    "relay": "tsx scripts/relay-kpi-metric.ts",
    "fund:test": "tsx scripts/fund-test-wallets.ts",
    "weth:deposit": "tsx scripts/drive-weth-kpi.ts --action deposit",
    "weth:withdraw": "tsx scripts/drive-weth-kpi.ts --action withdraw",
    "sygma:deposit": "tsx scripts/sygma-deposit.ts",
    "demo:seed": "tsx scripts/demo-seed.ts",
    "swap:weth-usdc": "tsx scripts/uniswap-swap.ts",
    "report-window": "tsx scripts/compute-report-window.ts"
  },
  "dependencies": {
    "@netlify/blobs": "11.0.2",
    "@tanstack/react-query": "^5.101.4",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "viem": "^2.55.10",
    "wagmi": "^3.7.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "playwright": "^1.62.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.5",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
