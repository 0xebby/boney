# Compiler files
cache/
out/

# Ignores development broadcast logs
!/broadcast
/broadcast/*/31337/
/broadcast/**/dry-run/

# Docs. `/docs/` is `forge doc` output — regenerable from the sources it documents, like out/ above,
# and 4 MB of it. The prose a reader needs is in README.md and boneyMd/.
#
# Anchored with a leading slash: unanchored, `docs/` matches a directory of that name at ANY depth,
# which silently swept up `web/src/app/docs/` (the /docs route) and `.claude/docs/`. Both are source.
/docs/
BoneyDocs.md
todo.md
todo-frontend.md
plan.md
future.md
changes.md

# Local testing notes. Holds throwaway Base Sepolia keys for driving the fixture by hand, and
# this repo is public — so it is ignored by name here as well as in .git/info/exclude.
testing.md

# Internal code reviews and the unpublished protocol spec. Both live in boneyMd/ alongside the
# published docs, and this repo is public — findings.md details high-severity bugs, so it must never
# be staged. Drop the spec/ rule when the spec is ready to publish.
boneyMd/findings.md
boneyMd/spec/
boneyMd

# One-off HTML explainers written to the repo root while working something out. The version of any
# of this that ships is prose in boneyMd/ or a page in the app.
/*.html

# Web app
web/node_modules/
web/.next/
web/out/
web/.vercel

# Dotenv file
.env
# Timestamped backups of the above, written when a deploy/seed script rewrites addresses. They carry
# the same PRIVATE_KEY / ATTESTOR_PRIVATE_KEY / ETHOS_PK, and a bare `.env` rule does not match them
# — so `git add -A` would have staged live deployer keys into a public repo.
.env.*
!.env.example

# Indexer block cursors — per-machine scan position, not shared state. Losing it costs a rescan,
# which is a no-op because reports are cumulative.
.indexer-state.json

# Claude Code worktrees. These are checkouts of *this* repo living inside it, so git records each
# one as a gitlink (mode 160000) with no matching .gitmodules entry — which makes every
# `git submodule` command abort with "no submodule mapping found". They are local scratch space
# and must never be committed; the branches themselves carry the work.
.claude/worktrees/

# Per-machine tool settings, not shared state. `.vscode/extensions.json` and `launch.json` are
# tracked because they are shared procedure; settings.json is whatever this machine happened to set.
.claude/settings.local.json
.vscode/settings.json

# Local agent skills. Kept out for now — promote one here if it becomes shared procedure.
.claude/skills/

# Campaign guides written by /api/campaign-guide — a local-dev convenience, not shared state.
# The committed catalog in web/src/lib/campaignGuide.ts is the path a deploy relies on.
web/.data/

# Scripts that fund wallets or manufacture campaign activity. This repo is public, and together these
# are a working recipe for standing up a funded campaign and moving its KPIs without anyone doing the
# work: `fund-test-wallets.ts` sends testnet ETH and ERC-20s out of the attestor key, the two seeds
# create and fund campaigns, and the rest emit the exact event a KPI credits — a WETH deposit, a Sygma
# GMP deposit, a Uniswap V3 swap, an approve→fund→activate driven through the UI.
#
# No secret is involved; the only embedded keys are the well-known Anvil accounts. What should not be
# public is the recipe. The protocol's own two reporting halves stay tracked — `indexer.ts` and
# `relay-kpi-metric.ts` read logs and report them, they do not create them.
#
# The matching `pnpm` aliases in web/package.json are left in place, so a working copy that still
# holds these files runs unchanged.
web/scripts/fund-test-wallets.ts
web/scripts/seed-local.ts
web/scripts/demo-seed.ts
web/scripts/drive-writes.mjs
web/scripts/drive-weth-kpi.ts
web/scripts/drive-event-kpi.mjs
web/scripts/sygma-deposit.ts
web/scripts/uniswap-swap.ts
web/scripts/gyndore-swap.ts

# Every .md except the one GitHub renders on the repo page. The rest is working material — the
# protocol spec, internal reviews, plans, launch notes, agent instructions — and this repo is public.
# `boneyMd/findings.md` details high-severity bugs and `testing.md` holds throwaway Base Sepolia keys,
# so neither may ever be staged; testing.md is in .git/info/exclude as well.
#
# `!README.md` is anchored: unanchored it would also re-include every nested README. A file inside an
# ignored directory cannot be re-included at all, which is why boneyMd/ below needs no exception.
*.md
!/README.md
boneyMd/

# Claude Code's whole directory — project instructions, docs, local skills, and worktrees. Working
# material rather than shared procedure. The worktrees especially must never be committed: each is a
# checkout of *this* repo living inside it, so git records it as a gitlink (mode 160000) with no
# matching .gitmodules entry, which makes every `git submodule` command abort with "no submodule
# mapping found". The branches themselves carry the work. Supersedes the narrower `.claude/…` rules
# above.
.claude/
